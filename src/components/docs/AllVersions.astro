---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import config from 'virtual:starlight-versions-config'

// Every version links to its docs root: older versions do not have every page.
const versions = [
  { label: config.current.label, href: '/docs/', latest: true },
  ...config.versions.map((version) => ({
    label: version.label ?? version.slug,
    href: `/${version.slug}/docs/`,
    latest: false,
  })),
]
---

<StarlightPage
  frontmatter={{
    title: 'All versions',
    description: 'Every published version of the DittoFS documentation.',
    tableOfContents: false,
  }}
>
  <p>Every published version of the DittoFS documentation, newest first.</p>
  <ul class="versions not-content">
    {
      versions.map(({ label, href, latest }) => (
        <li>
          <a href={href} class:list={{ latest }}>
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</StarlightPage>

<style>
  .versions {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
    list-style: none;
    margin-top: 1.5rem;
    padding: 0;
  }

  a {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    color: var(--sl-color-white);
    display: block;
    font-weight: 600;
    padding: 0.75rem 1rem;
    text-decoration: none;
  }

  a:hover {
    background-color: var(--sl-color-gray-6);
    border-color: var(--sl-color-gray-4);
  }

  a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .latest {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-accent);
  }
</style>
